# 로컬 개발용 환경변수 예시 — `.env`로 복사해 사용
# 백엔드(Spring Boot) 로컬 서버 주소. CORS는 백엔드가 localhost:5173을 허용함.
# 프로덕션 빌드는 `.env.production`(VITE_API_BASE_URL=/api, nginx 리버스 프록시)이 우선 적용됨.
VITE_API_BASE_URL=http://localhost:8080/api

# 네이버 클라우드 플랫폼 Maps(Dynamic Map) 클라이언트 키.
# NCP 콘솔에서 애플리케이션 등록 후 http://localhost:5173 을 서비스 URL로 등록해야 한다.
# 미설정 시 지도 대신 플레이스홀더가 표시된다(레이아웃 개발/리뷰 가능).
VITE_NAVER_MAP_CLIENT_ID=

# true면 백엔드 grid-risk API를 건너뛰고 개발용 폴백 격자 데이터를 사용한다.
VITE_USE_GRID_FALLBACK=
